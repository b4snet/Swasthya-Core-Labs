root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion

[*.{json,jsonc,yml,yaml,csproj,props,targets,config,editorconfig,http}]
indent_size = 2

# EF Core generated migration code is not hand-maintained; CA1861 flags its
# repeated constant index-column arrays, which cannot be expressed differently.
[src/Swasthya.CoreLabs.Infrastructure/Persistence/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none

[*.ps1]
indent_size = 4

[*.md]
trim_trailing_whitespace = false