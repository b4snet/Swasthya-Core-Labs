# Swasthya Core Labs — environment variable template
# Copy this file to `.env` for local tooling. NEVER commit real values.
# Secrets are provisioned through a secrets manager in deployed environments,
# never through environment files checked into source control.
# See: docs/development.md, docs/security/security-architecture.md

ENVIRONMENT=Development

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5249

# Connection string placeholders — DO NOT populate with real credentials.
# CONNECTIONSTRINGS__CLINICAL=__PLACEHOLDER_DO_NOT_POPULATE__
# CONNECTIONSTRINGS__CORELABS=__PLACEHOLDER_DO_NOT_POPULATE__

# Authentication (JWT validation contract). Production requires a signing key
# OR a JWKS URL (see docs/security/security-architecture.md).
# AUTHENTICATION__ISSUER=__PLACEHOLDER_DO_NOT_POPULATE__
# AUTHENTICATION__AUDIENCE=__PLACEHOLDER_DO_NOT_POPULATE__
# AUTHENTICATION__SIGNINGKEYBASE64=__PLACEHOLDER_DO_NOT_POPULATE__
# AUTHENTICATION__JWKSURL=__PLACEHOLDER_DO_NOT_POPULATE__

# Test harness connectivity (see docs/development.md)
# SCL_PG_TEST_CONNECTION=__PLACEHOLDER_DO_NOT_POPULATE__
# SCL_DB_CONNECTION=__PLACEHOLDER_DO_NOT_POPULATE__  # design-time migrations

# Logging
LOG_LEVEL__DEFAULT=Information
LOG_LEVEL__MICROSOFT_ASPNETCORE=Warning